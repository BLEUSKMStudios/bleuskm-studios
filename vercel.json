{
  "cleanUrls": true,
  "ignoreCommand": "P=\"$VERCEL_GIT_PREVIOUS_SHA\"; [ -n \"$P\" ] || exit 1; git cat-file -e \"$P^{commit}\" 2>/dev/null || git fetch --quiet --depth=500 origin \"$P\" 2>/dev/null || exit 1; git diff --quiet \"$P\" HEAD -- . ':(exclude)studio' ':(exclude).github'",
  "redirects": [
    {
      "source": "/studio",
      "destination": "https://bleuskm-studio-os.vercel.app/",
      "permanent": false
    },
    {
      "source": "/studio/:path*",
      "destination": "https://bleuskm-studio-os.vercel.app/",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "https://bleuskm-studio-os.vercel.app/",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://bleuskm-studio-os.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/.netlify/functions/:func",
      "destination": "/api/:func"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
