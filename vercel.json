{
  "cleanUrls": true,
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)studio' ':(exclude).github'",
  "redirects": [
    {
      "source": "/studio",
      "destination": "https://studio.bleuskm.com/",
      "permanent": false
    },
    {
      "source": "/studio/:path*",
      "destination": "https://studio.bleuskm.com/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/.netlify/functions/:func",
      "destination": "/api/:func"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
